# Create the API key in Resend and add it to your local environment and Vercel.
RESEND_API_KEY=re_replace_with_your_key

# This must use a domain verified in your Resend account.
RESEND_FROM_EMAIL="XLIT <orders@your-verified-domain.com>"

# Recipient for customization requests.
RESEND_TO_EMAIL=frank.wilson.incall@gmail.com

# These account identifiers are shown publicly at checkout. Use distinct accounts.
NEXT_PUBLIC_VODAFONE_CASH_NUMBER=01000000000
NEXT_PUBLIC_INSTAPAY_ACCOUNT=your-instapay-account

# Supabase catalog, reviews, and future admin area.
# The publishable key is safe in browser code; the secret key is server-only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_key
SUPABASE_SECRET_KEY=sb_secret_replace_with_your_key

# Server-only allowlist permitted to manage the XLIT catalog (comma-separated).
ADMIN_EMAIL=frank.wilson.incall@gmail.com,mohnadgasim77@gmail.com
